FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY p2p_share ./p2p_share
COPY api ./api
RUN pip install --no-cache-dir ".[api]"

ENV PYTHONUNBUFFERED=1
EXPOSE 8000 9000

# One worker only: the event bus keeps its history in this process.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
